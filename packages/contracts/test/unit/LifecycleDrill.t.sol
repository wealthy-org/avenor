pragma solidity 0.8.18;

import { Test } from "forge-std/Test.sol";
import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import { TokenizedStrategy } from "tokenized-strategy/TokenizedStrategy.sol";
import { Deploy } from "../../script/Deploy.s.sol";
import { IVaultV3 } from "../../src/interfaces/IVaultV3.sol";
import { IAccountant } from "../../src/interfaces/IAccountant.sol";
import { MorphoVaultStrategy } from "../../src/strategies/MorphoVaultStrategy.sol";
import { MockERC20 } from "../mocks/MockERC20.sol";
import { MockVenue } from "../mocks/MockVenue.sol";
import { MockYearnFactory } from "../mocks/MockYearnFactory.sol";

/// @title LifecycleDrillTest
/// @notice Comprehensive operational lifecycle and emergency drill verification per Brief §15 and GAP ANALYSIS AV-3.
///         Proves:
///           1. Normal round-trip lifecycle (Deposit -> Allocate -> Gain/Report -> Fee Distribution -> Partial Withdraw -> Full Redeem)
///           2. Loss path invariant (max_loss = 0 revert enforcement vs max_loss > 0 success)
///           3. Deposit freeze invariant (deposit_limit = 0 blocks deposits but leaves withdrawals intact)
///           4. Emergency pause drill (setPaused(true) blocks both deposits & withdrawals per Yearn V3 core)
///           5. Unauthorized role attempt rejections
contract LifecycleDrillTest is Test {
    address internal constant TS_IMPL = 0x3110D1Eec90f0651C18e75AD37711A8777342504;

    uint256 internal constant INITIAL_CAP = 500_000e6; // 500k USDG
    uint256 internal constant USER_DEPOSIT = 100_000e6; // 100k USDG
    uint256 internal constant ALLOCATION = 80_000e6; // 80k USDG to strategy, 20k idle
    uint256 internal constant YIELD_GAIN = 3_000e6; // 3k USDG yield generated by venue (3.75% < 5% maxGain)

    Deploy internal deployer;
    MockERC20 internal usdg;
    MockVenue internal venue;

    address internal guardian = makeAddr("guardian");
    address internal keeper = makeAddr("keeper");
    address internal treasury = makeAddr("treasury");
    address internal timelock = makeAddr("timelock");
    address internal emergencyTimelock = makeAddr("emergencyTimelock");
    address internal user = makeAddr("user");
    address internal attacker = makeAddr("attacker");

    IVaultV3 internal vault;
    IAccountant internal accountant;
    MorphoVaultStrategy internal strategy;

    function setUp() public {
        deployer = new Deploy();
        usdg = new MockERC20("USDG", "USDG", 6);
        venue = new MockVenue(address(usdg));

        // Etch TokenizedStrategy implementation at canonical address 4663
        MockYearnFactory yearnFactory = new MockYearnFactory();
        TokenizedStrategy template = new TokenizedStrategy(address(yearnFactory));
        vm.etch(TS_IMPL, address(template).code);

        Deploy.Config memory cfg = Deploy.Config({
            mode: Deploy.Mode.DryRun,
            actor: address(deployer),
            usdg: address(usdg),
            venue: address(venue),
            timelock: timelock,
            proposer: timelock,
            guardian: guardian,
            keeper: keeper,
            treasury: treasury,
            management: address(0),
            maxDebt: INITIAL_CAP,
            minimumTotalIdle: 0,
            seedAssets: 0,
            vaultName: "Avenor USDG Managed Vault",
            vaultSymbol: "avUSDG",
            strategyName: "Avenor USDG steakUSDG",
            factoryName: "Avenor Vault Factory",
            placeholdersUsed: false,
            gitRev: "lifecycle-drill",
            feeRecipient: treasury,
            performanceFee: 1_000, // 10%
            managementFee: 0,
            refundRatio: 0,
            maxFee: 0,
            maxGain: 500, // 5% max gain per report
            maxLoss: 200 // 2% max loss per report
        });

        Deploy.Deployment memory d = deployer.deployAll(cfg);
        vault = IVaultV3(d.vault);
        accountant = IAccountant(d.accountant);
        strategy = MorphoVaultStrategy(d.strategy);

        // Verify initial closed state (Brief & AV-1 requirement)
        assertEq(vault.deposit_limit(), 0, "Initial deposit_limit must be 0");
        assertEq(vault.totalAssets(), 0, "Initial totalAssets must be 0");
        assertEq(vault.totalSupply(), 0, "Initial totalSupply must be 0");

        // Timelock opens deposit limit for drill
        vm.prank(timelock);
        vault.set_deposit_limit(INITIAL_CAP);
        assertEq(vault.deposit_limit(), INITIAL_CAP, "Deposit limit opened by timelock");

        // Fund user
        usdg.mint(user, USER_DEPOSIT * 2);
        vm.prank(user);
        usdg.approve(address(vault), type(uint256).max);
    }

    /// @notice Proves full round-trip normal lifecycle (Brief §15 & AV-3)
    function test_lifecycle_normal_round_trip() public {
        // Step 1: Deposit
        vm.prank(user);
        uint256 sharesMinted = vault.deposit(USER_DEPOSIT, user);
        assertEq(sharesMinted, USER_DEPOSIT, "1:1 share ratio on initial deposit (6 decimals)");
        assertEq(vault.totalAssets(), USER_DEPOSIT, "Total assets equals deposit");
        assertEq(vault.totalIdle(), USER_DEPOSIT, "All assets idle before allocation");
        assertEq(usdg.balanceOf(user), USER_DEPOSIT, "User spent exactly deposit amount");

        // Step 2: Keeper allocates idle to strategy
        vm.prank(keeper);
        vault.update_debt(address(strategy), ALLOCATION);
        assertEq(vault.totalIdle(), USER_DEPOSIT - ALLOCATION, "Idle reduced by allocation");
        assertEq(vault.totalDebt(), ALLOCATION, "Vault totalDebt matches allocation");
        assertEq(
            vault.strategies(address(strategy)).current_debt,
            ALLOCATION,
            "Strategy debt matches allocation"
        );

        // TokenizedStrategy latches lastTotalAssets on same block. Advance block timestamp.
        vm.warp(block.timestamp + 1);

        // Step 3: Venue earns yield and keeper processes report
        venue.setTotalAssets(ALLOCATION + YIELD_GAIN);
        usdg.mint(address(venue), YIELD_GAIN);
        uint256 expectedPerformanceFeeAssets = (YIELD_GAIN * 1_000) / 10_000; // 10% = 300 USDG

        vm.prank(keeper);
        (uint256 gain, uint256 loss) = vault.process_report(address(strategy));
        assertEq(gain, YIELD_GAIN, "Reported gain matches venue yield");
        assertEq(loss, 0, "No loss reported");

        // Check fee shares minted to Accountant
        assertEq(
            vault.balanceOf(address(accountant)),
            expectedPerformanceFeeAssets,
            "Fee shares minted to accountant"
        );

        // Unlock profit over 7 days (Yearn V3 profit unlock mechanism)
        vm.warp(block.timestamp + 7 days);

        // Step 4: Partial withdrawal (20k USDG) with explicit max_loss = 0
        uint256 withdrawAmount = 20_000e6;
        uint256 userBalanceBefore = usdg.balanceOf(user);
        vm.prank(user);
        uint256 sharesBurned = vault.withdraw(withdrawAmount, user, user, 0); // max_loss = 0
        assertTrue(sharesBurned > 0, "Shares burned on withdrawal");
        assertEq(
            usdg.balanceOf(user),
            userBalanceBefore + withdrawAmount,
            "User received exact withdraw amount"
        );

        // Step 5: Full redeem of remaining user shares with explicit max_loss = 0
        uint256 userSharesRemaining = vault.balanceOf(user);
        assertTrue(userSharesRemaining > 0, "User has remaining shares");
        vm.prank(user);
        uint256 assetsRedeemed = vault.redeem(userSharesRemaining, user, user, 0); // max_loss = 0
        assertTrue(assetsRedeemed > 0, "Assets redeemed from remaining shares");
        assertEq(vault.balanceOf(user), 0, "User has 0 shares remaining");

        // Final sanity: User received initial principal + net gain
        uint256 netUserPnl = usdg.balanceOf(user) - (USER_DEPOSIT * 2);
        assertTrue(netUserPnl > 0, "User earned net positive yield");
    }

    /// @notice Proves loss enforcement invariant: max_loss = 0 MUST revert when loss occurs (Brief §15 & K-8)
    function test_lifecycle_loss_enforcement_drill() public {
        // User deposits 100k USDG
        vm.prank(user);
        vault.deposit(USER_DEPOSIT, user);

        // Keeper allocates 80k to strategy
        vm.prank(keeper);
        vault.update_debt(address(strategy), ALLOCATION);

        // Advance block timestamp so TokenizedStrategy refreshes valuation
        vm.warp(block.timestamp + 1);

        // Venue experiences an unrealised loss of 1,000 USDG (1.25% < 2% maxLoss)
        uint256 venueLoss = 1_000e6;
        venue.setTotalAssets(ALLOCATION - venueLoss);

        // With zero max_loss (0 bps), withdrawal that incurs unrealised loss must revert
        uint256 withdrawAttempt = 50_000e6; // Exceeds 20k idle, forcing pull from strategy with loss
        vm.prank(user);
        vm.expectRevert(bytes("too much loss"));
        vault.withdraw(withdrawAttempt, user, user, 0); // max_loss = 0 bps

        // With explicit tolerated max_loss (e.g. 500 bps = 5%), withdrawal succeeds
        vm.prank(user);
        uint256 sharesBurned = vault.withdraw(withdrawAttempt, user, user, 500); // max_loss = 500 bps
        assertTrue(sharesBurned > 0, "Withdrawal succeeded with explicit loss tolerance");

        // Now keeper reports remaining loss
        vm.prank(keeper);
        (uint256 gain, uint256 loss) = vault.process_report(address(strategy));
        assertEq(gain, 0, "No gain");
        assertTrue(loss > 0, "Loss absorbed and reported");
    }

    /// @notice Proves operational deposit freeze drill: deposit_limit = 0 blocks deposits without affecting withdrawals
    function test_operational_deposit_freeze_drill() public {
        // User deposits 50k USDG while limit is open
        vm.prank(user);
        vault.deposit(50_000e6, user);

        // Timelock freezes deposits by setting limit to 0
        vm.prank(timelock);
        vault.set_deposit_limit(0);
        assertEq(vault.deposit_limit(), 0, "Deposit limit set to 0 (Frozen)");

        // New deposit attempt MUST revert (limit reached)
        vm.prank(user);
        vm.expectRevert();
        vault.deposit(10_000e6, user);

        // Crucial invariant: Existing user CAN STILL WITHDRAW normally during deposit freeze!
        vm.prank(user);
        uint256 sharesBurned = vault.withdraw(25_000e6, user, user, 0);
        assertTrue(sharesBurned > 0, "Withdrawal succeeds during deposit freeze");
    }

    /// @notice Proves emergency pause drill: setPaused(true) blocks BOTH deposits AND withdrawals
    function test_emergency_pause_and_unpause_drill() public {
        // User deposits 50k USDG
        vm.prank(user);
        vault.deposit(50_000e6, user);

        // Guardian/Emergency sets pause
        vm.prank(guardian);
        vault.setPaused(true);
        assertTrue(vault.isPaused(), "Vault is paused");

        // Deposits are blocked
        vm.prank(user);
        vm.expectRevert();
        vault.deposit(10_000e6, user);

        // Withdrawals are ALSO blocked when paused (Yearn V3 Vyper:774)
        vm.prank(user);
        vm.expectRevert();
        vault.withdraw(10_000e6, user, user, 0);

        // Guardian unpauses
        vm.prank(guardian);
        vault.setPaused(false);
        assertFalse(vault.isPaused(), "Vault is unpaused");

        // Withdrawals work again
        vm.prank(user);
        uint256 sharesBurned = vault.withdraw(10_000e6, user, user, 0);
        assertTrue(sharesBurned > 0, "Withdrawal succeeds after unpausing");
    }

    /// @notice Proves role authorization boundaries: unprivileged accounts are rejected on sensitive operations
    function test_unauthorized_role_rejections() public {
        vm.startPrank(attacker);

        // Cannot update debt
        vm.expectRevert();
        vault.update_debt(address(strategy), 10_000e6);

        // Cannot process report
        vm.expectRevert();
        vault.process_report(address(strategy));

        // Cannot set deposit limit
        vm.expectRevert();
        vault.set_deposit_limit(1_000_000e6);

        // Cannot pause
        vm.expectRevert();
        vault.setPaused(true);

        vm.stopPrank();
    }
}
