# Environment variables for Avenor Web Application
# Copy this file to `.env.local` for local development.

# --- Robinhood Chain Testnet (Chain ID 46630) ---
# NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
# AVENOR_VAULTS=[{"address":"0xFB6064C2A4CedaD01b2a873E43890D18e1Cb4Dd9","label":"Avenor USDG Managed Vault (Testnet)","phase":"research","mandate":"Testnet Stage Rehearsal"}]

# --- Robinhood Chain Mainnet (Chain ID 4663) ---
# NEXT_PUBLIC_RPC_URL=https://rpc.solidrpc.io/public/evm/4663
# AVENOR_VAULTS=[]

# Optional external API base URL (empty uses Next.js internal /v1 routes)
AVENOR_API_URL=

# --- Contract deployment only; never put private keys here ---
# GOVERNANCE_OWNER_1=0x...
# GOVERNANCE_OWNER_2=0x...
# GOVERNANCE_OWNER_3=0x...
