# Salin ke `.env` (tidak di-commit) lalu `set -a; . ./.env; set +a`.
# Nilai di bawah adalah placeholder; jangan pernah commit nilai asli.

# RPC chain 4663 yang bisa melayani STATE HISTORIS (archive).
# Dipakai test/fork/*. Kosongkan bila belum ada -> fork test skip loud.
#
# JANGAN isi dengan https://rpc.mainnet.chain.robinhood.com. Dua alasan, keduanya
# terverifikasi 2026-11-19:
#   1. Host itu tidak melayani state historis (butuh arsip untuk blok 118337511).
#   2. Dari jaringan build, DNS-nya di-hijack ISP (202.62.8.233) dan menjawab
#      HTTP 302 ke internetsehat.iconpln.net.id; sertifikatnya juga sudah expired.
#      Jadi request tidak pernah sampai ke node.
# Pakai endpoint archive dari provider. Yang TERBUKTI masih melayani pin 118337511
# (dicek 2026-11-19, keyless):
#   https://rpc.solidrpc.io/public/evm/4663
#   https://robinhood.api.onfinality.io/public
# Yang TIDAK bisa (jangan buang waktu): drpc sudah prune blok ini (balas
# "Unknown state. First available state is 1"; jendranya hanya ~150-200 blok),
# publicnode/thirdweb menolak state historis, robinhood.dwellir.com dan
# robinhood-mainnet.public.blastapi.io menolak chain ini, demo Alchemy 401.
FORK_RPC_URL=

# "true" = fork test gagal (bukan skip) bila FORK_RPC_URL tidak melayani blok pin.
# Pakai "true" di CI/rilis; "false" untuk kerja lokal tanpa arsip.
# Terbaik: `python scripts/fork-test.py`, yang memverifikasi pin lebih dulu, mem-fork
# lewat anvil lokal, lalu meneruskan ke forge dengan tiga flag wajib:
#   --fork-url http://127.0.0.1:<port>  (forge 1.9 butuh eth_getAccountInfo; anvil punya,
#                                        endpoint publik tidak)
#   --fork-state-by-number              (drpc/solidrpc tolak parameter EIP-1898 berbentuk object)
#   --hardfork cancun                    (default london -> bytecode venue PUSH0 halt:
#                                        `EvmError: NotActivated`; jangan ubah evm_version di
#                                        foundry.toml karena itu mengubah bytecode kita)
FORK_STRICT=false

# Endpoint lain yang ikut diprobe scripts/fork-status.py (comma separated), mis. untuk
# membandingkan dua provider sebelum memilih. FORK_RPC_URL selalu diprobe lebih dulu.
FORK_EXTRA_RPCS=

# --- script/Deploy.s.sol -----------------------------------------------------
# Akun yang menandatangani semua call privilese (deployer EOA / hardware wallet).
# Wajib diisi saat memakai `forge script --broadcast`: script tidak boleh membaca
# msg.sender di dalam broadcast, jadi alamat ini eksplisit. Bila salah, call
# `set_role` pertama revert NotRoleManager (vault dibuat dengan role_manager =
# alamat ini) — bukan kegagalan senyap.
# Isi di `.env` (di-ignore), jangan di file ini. File ini masuk git.
DEPLOYER_ADDRESS=

# Kunci privat untuk broadcast. Harus cocok dengan DEPLOYER_ADDRESS.
# Kosongkan bila memakai node dengan akun terbuka (anvil).
# JANGAN pernah isi nilai asli di sini: `.env.example` di-commit (lihat
# `!.env.example` di `.gitignore`), jadi apa pun yang ditulis di baris ini
# berakhir di riwayat git. Salin file ini ke `.env` lalu isi di sana.
# Rehearsal anvil memakai kunci #0 yang sudah publik — itu boleh ditulis
# langsung di perintah, bukan di file ini (lihat docs/DEPLOYMENT.md §5.1).
PRIVATE_KEY=

# dry-run | stage | prod
DEPLOY_MODE=dry-run

# Alamat yang dipakai. Default = alamat chain 4663 di packages/config.
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
VENUE_ADDRESS=0xBeEff033F34C046626B8D0A041844C5d1A5409dd

# prod/stage: TimelockController yang sudah ada (>= 48 jam).
# Kosong = script men-deploy TimelockController baru (hanya dry-run yang boleh).
TIMELOCK_ADDRESS=
# Proposer + guardian. Mode prod menolak EOA dan menolak proposer == deployer.
PROPOSER_ADDRESS=
GUARDIAN_ADDRESS=
KEEPER_ADDRESS=
TREASURY_ADDRESS=
# Pemilik baru strategy (management TokenizedStrategy). Kosong = timelock.
MANAGEMENT_ADDRESS=

# Batas kredit strategy dalam USDG (6 desimal: 1000e6 ditulis 1000000000).
# 0 sampai keputusan limited launch.
STRATEGY_MAX_DEBT=0
# Idle minimum yang tidak boleh di-update_debt (6 desimal). 0 = tanpa buffer.
MINIMUM_TOTAL_IDLE=0
# Dead-share seed (ADR-7). 0 = lewati.
SEED_ASSETS=0

# Provenance di deployments/<chainId>.<mode>.json. Isi dengan `git rev-parse HEAD`.
GIT_REV=
